# Esempio: una funzione continua campionata su una griglia finita.

def f_continua(x):
    return np.exp(-x) * (np.sin(2*np.pi*x) + 2)

x_fine = np.linspace(0, 1, 600)
x_grid = np.linspace(0, 1, 21)

